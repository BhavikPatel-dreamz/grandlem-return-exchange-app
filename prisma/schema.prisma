// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// ---- Phase 1: Returns data model ----

model ReturnReason {
  id        String   @id @default(cuid())
  shop      String
  labelEn   String
  labelSv   String   @default("")
  // return | exchange | complaint | any (comma list) - simplified as string
  appliesTo String   @default("return,exchange,complaint")
  autoRestock Boolean @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ReturnItem[]

  @@index([shop])
  @@index([shop, active])
}

model Settings {
  id        String   @id @default(cuid())
  shop      String   @unique
  returnDeadlineDays    Int      @default(14)
  exchangeDeadlineDays  Int      @default(14)
  complaintDeadlineDays    Int      @default(14)
  // Phase 12: refunds
  autoRefundOnInspection Boolean @default(false)
  refundShippingCost      Boolean @default(false)
  // Phase 13: store credit & deflection
  deflectionEnabled       Boolean @default(true)
  storeCreditEnabled      Boolean @default(true)
  storeCreditMethod       String  @default("gift_card") // store_credit | gift_card
  storeCreditBonusPercent Int     @default(10)
  storeCreditIssueTiming  String  @default("on_inspection")
  // Phase 16: complaints
  complaintResolutionMode String  @default("customer_chooses")
  complaintRequireItemReturn Boolean @default(true)
  // Phase 17: advanced exchanges
  exchangeShipTiming       String  @default("SHIP_IMMEDIATELY")
  exchangeReserveDays      Int     @default(7)
  offerCreditWhenUnavailable Boolean @default(true)
  // Phase 18: smart refunds
  clawBackFreeItems        Boolean @default(true)
  // Phase 10: claim evidence requirements
  claimRequiresPhoto    Boolean  @default(true)
  claimMinPhotos        Int      @default(1)
  claimMinCommentLength Int     @default(20)
  // JSON: { "SE": "immediate" | "after_approval", ... }
  labelTimingPerMarket  String   @default("{}")
  // JSON: { "SE": { carrierId, service }, ... } fallback routing per market
  defaultReturnMethodPerMarket String @default("{}")
  // JSON: { "SE": { name, address, city, zip, country }, ... }
  warehouseAddressesPerMarket String @default("{}")
  shopifyLocationIdPerMarket String @default("{}")
  // Phase 4B: per-shop ShippyPro credentials (encrypted at rest)
  shippyproApiKeyEncrypted String?
  shippyproApiKeyHint      String?
  shippyproApiUrl          String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeadlineExtension {
  id        String   @id @default(cuid())
  shop      String
  shopifyOrderId String
  type      String   // return | exchange | complaint
  newDeadline DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, shopifyOrderId])
  @@unique([shop, shopifyOrderId, type])
}

model ExclusionRule {
  id             String   @id @default(cuid())
  shop           String
  targetType     String   // collection | product | variant
  targetId       String   // Shopify GID or numeric id
  appliesToReturns    Boolean @default(true)
  appliesToExchanges  Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shop])
  @@index([shop, targetType, targetId])
  @@unique([shop, targetType, targetId])
}

model Carrier {
  id              String   @id @default(cuid())
  shop            String
  shippyproCarrierId String
  name            String
  service         String?
  isDefault       Boolean  @default(false)
  market          String?
  meta            String?  // JSON
  syncedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, shippyproCarrierId])
  @@index([shop])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  shop      String
  event     String   // received | approved | rejected | payment_required
  language  String   // en | sv
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, event, language])
  @@index([shop])
}

model ReturnRequest {
  id            String   @id @default(cuid())
  shop          String
  shopifyOrderId String?
  orderNumber   String?
  requestNumber String?
  market        String?
  customerEmail String?
  customerName  String?
  type          String   // return | exchange | complaint
  status        String   @default("Submitted")
  carrierId     String?
  reviewFlagged Boolean  @default(false)
  countryCode String @default("")
  outcome ReturnOutcome?
  // Phase 13
  requestedResolution     String?
  // Phase 14: EU withdrawal
  isWithdrawal           Boolean @default(false)
  acknowledgementContent  String?
  finalResolution        String?
  replacementOrderId     String?
  itemReturnRequired     Boolean @default(true)
  // Phase 17
  draftOrderId           String?
  reservedUntil          DateTime?
  withdrawalNotice        WithdrawalNotice? @relation("WithdrawalReturn")
  deflectionOffered       Boolean @default(false)
  deflectionAccepted      Boolean @default(false)
  storeCreditAmount       Float?
  storeCreditIssuedAt     DateTime?
  rejectionReason String?
  submittedAt   DateTime @default(now())
  approvedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         ReturnItem[]
  label         ReturnLabel?
  refunds       RefundRecord[]

  @@index([shop])
  @@index([shop, status])
  @@index([shop, shopifyOrderId])
}

model ReturnItem {
  id             String   @id @default(cuid())
  returnRequestId String
  returnRequest  ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  shopifyLineItemId String?
  productId      String?
  variantId      String?
  title          String?
  quantity       Int      @default(1)
  returnedQuantity Int    @default(0)
  reasonId       String?
  reason         ReturnReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  comment        String?
  restockDecision String?  // auto | manual | pending
  restocked      Boolean  @default(false)
  restockedAt    DateTime?
  restockLocationId String?
  itemResolution    String?
  // exchange
  replacementVariantId String?
  priceDifferenceStr String? // stored as string e.g. "12.50"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  photos         ReturnPhoto[]
  inspection     InspectionResult?

  @@index([returnRequestId])
}

model ReturnPhoto {
  id         String   @id @default(cuid())
  returnItemId String
  returnItem ReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  url        String
  fileName   String?
  mimeType   String?
  size       Int?
  createdAt  DateTime @default(now())

  @@index([returnItemId])
}

model InspectionResult {
  id             String   @id @default(cuid())
  returnItemId   String   @unique
  returnItem     ReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  condition      String   // OK | DAMAGED | WRONG_ITEM | MISSING
  approvedQuantity Int    @default(0)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ReturnLabel {
  id            String   @id @default(cuid())
  returnRequestId String @unique
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  carrierId     String?
  connectionId  String?
  service       String?
  labelUrl      String?
  qrCodeUrl     String?
  trackingNumber String?
  trackingUrl   String?
  status        String   @default("pending")
  customsData   String?  // JSON
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events        TrackingEvent[]

  @@index([returnRequestId])
}

model RefundRecord {
  id             String   @id @default(cuid())
  returnRequestId String
  returnRequest  ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  shopifyRefundId String?
  amount         Float    @default(0)
  currency       String?
  status         String   @default("pending") // pending | refunded | failed
  note           String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([returnRequestId])
}

model WithdrawalNotice {
  id             String   @id @default(cuid())
  shop           String
  orderNumber    String?
  customerName   String?
  customerEmail  String?
  content        String
  withdrawnAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  returnRequestId String? @unique
  returnRequest   ReturnRequest? @relation("WithdrawalReturn", fields: [returnRequestId], references: [id])
}

model CourierService {
  id                String   @id @default(cuid())
  shop              String
  shippyproCarrierId String
  service           String?
  supportsReturns   Boolean  @default(true)
  supportsPickup    Boolean  @default(false)
  supportsQr        Boolean  @default(false)
  supportsDropoff   Boolean  @default(true)
  meta              String?  // JSON
  syncedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop])
  @@unique([shop, shippyproCarrierId, service])
}

model ReturnPickup {
  id            String   @id @default(cuid())
  returnRequestId String
  status        String   @default("pending") // pending | booked | failed | needs_manual_booking
  carrierId     String?
  service       String?
  preferredDate DateTime?
  timeWindow    String?
  address       String?  // JSON
  shippyproPickupId String?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([returnRequestId])
}

model TrackingEvent {
  id            String   @id @default(cuid())
  returnLabelId String?
  returnLabel   ReturnLabel? @relation(fields: [returnLabelId], references: [id], onDelete: Cascade)
  returnRequestId String?
  status        String
  message       String?
  occurredAt    DateTime @default(now())
  raw           String?  // JSON
  createdAt     DateTime @default(now())

  @@index([returnLabelId])
  @@index([returnRequestId])
}


model DailyOrderStat {
  id             String   @id @default(cuid())
  shop           String
  date           DateTime
  marketCode     String   @default("")
  fulfilledOrders Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, date, marketCode])
  @@index([shop, date])
}


enum ReturnOutcome {
  REFUND
  EXCHANGE_VARIANT
  STORE_CREDIT
}
